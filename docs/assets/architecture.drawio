        <mxCell id="layerBiz" value="业务层　WarehouseService" style="swimlane;startSize=26;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontColor=#1f2d3d;" vertex="1" parent="1">
          <mxGeometry x="40" y="200" width="920" height="270" as="geometry" />
        </mxCell>

        <mxCell id="idxHash" value="&lt;b&gt;HashTable&amp;nbsp; 哈希表&lt;/b&gt;&lt;br&gt;&lt;br&gt;id → Item&lt;br&gt;&lt;br&gt;链地址法冲突处理&lt;br&gt;装填因子 0.75 扩容&lt;br&gt;&lt;br&gt;&lt;b&gt;O(1)&lt;/b&gt; 增删改查" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="layerBiz">
          <mxGeometry x="20" y="40" width="212" height="205" as="geometry" />
        </mxCell>

        <mxCell id="idxPrice" value="&lt;b&gt;AVLTree&amp;nbsp; 价格索引&lt;/b&gt;&lt;br&gt;&lt;br&gt;price → [id]&lt;br&gt;&lt;br&gt;四种旋转维持平衡&lt;br&gt;重复键桶化&lt;br&gt;&lt;br&gt;&lt;b&gt;O(log n)&lt;/b&gt; 区间查询" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="layerBiz">
          <mxGeometry x="246" y="40" width="212" height="205" as="geometry" />
        </mxCell>

        <mxCell id="idxStock" value="&lt;b&gt;AVLTree&amp;nbsp; 库存索引&lt;/b&gt;&lt;br&gt;&lt;br&gt;stock → [id]&lt;br&gt;&lt;br&gt;低库存告警&lt;br&gt;按库存排序&lt;br&gt;&lt;br&gt;&lt;b&gt;O(log n + k)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="layerBiz">
          <mxGeometry x="472" y="40" width="212" height="205" as="geometry" />
        </mxCell>

        <mxCell id="idxList" value="&lt;b&gt;DoublyLinkedList&lt;/b&gt;&lt;br&gt;&lt;b&gt;操作日志&lt;/b&gt;&lt;br&gt;&lt;br&gt;尾部追加 O(1)&lt;br&gt;反向遍历最新在前&lt;br&gt;滚动窗口淘汰最旧&lt;br&gt;&lt;br&gt;默认上限 2000 条" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="layerBiz">
          <mxGeometry x="698" y="40" width="202" height="205" as="geometry" />
        </mxCell>

