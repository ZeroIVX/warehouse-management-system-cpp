        <mxCell id="title" value="仓库管理系统 v2 · 分层架构与索引设计" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#1f2d3d;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="920" height="40" as="geometry" />
        </mxCell>

        <mxCell id="layerUI" value="表现层　ConsoleApp（console_ui）" style="swimlane;startSize=26;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontColor=#1f2d3d;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="920" height="110" as="geometry" />
        </mxCell>
        <mxCell id="uiApp" value="菜单与表格渲染（UTF-8 显示宽度对齐）　|　输入校验框架（getline + 显式解析，杜绝死循环）　|　落盘时机控制" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="layerUI">
          <mxGeometry x="20" y="40" width="880" height="55" as="geometry" />
